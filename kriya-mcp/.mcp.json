{
  "//": "TEMPLATE — copy this block into your assistant's MCP config and replace the /ABSOLUTE/PATH placeholders. For Claude Desktop on macOS that file is ~/Library/Application Support/Claude/claude_desktop_config.json. See kriya-mcp/README.md.",
  "mcpServers": {
    "spent": {
      "command": "kriya-mcp",
      "args": [
        "--persistent",
        "--name", "spent",
        "--exec", "/ABSOLUTE/PATH/TO/Spent/src-tauri/target/release/kriya_exec",
        "--tools", "/ABSOLUTE/PATH/TO/Spent/kriya-mcp/tools.json",
        "--policy", "/ABSOLUTE/PATH/TO/Spent/kriya-mcp/agent-policy.yaml",
        "--approval", "gui",
        "--actor", "claude-desktop"
      ],
      "env": {
        "SPENT_DB_PATH": "/ABSOLUTE/PATH/TO/Library/Application Support/com.spent.app/spent.db"
      }
    }
  }
}
